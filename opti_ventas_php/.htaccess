# Opti Ventas — Configuración de Apache (Laravel-like front controller)
# Compatible con Laragon, InfinityFree, cPanel y hosts con mod_rewrite disponible.

Options -Indexes +FollowSymLinks
DirectoryIndex index.php

# Bloquear acceso web a archivos sensibles (dotfiles, .env, SQL, docs, etc.)
<FilesMatch "^\.|\.(env|sql|lock|md|log|ini|json|xml|example)$">
    Require all denied
</FilesMatch>

# El instalador es solo de uso CLI
<Files "setup.php">
    Require all denied
</Files>

RewriteEngine On
RewriteBase /

# Bloquear acceso directo al código fuente y metadatos internos
RewriteRule ^(app|config|database|views|\.git|\.kiro)(/|$) - [F,L]

# Asegura que cualquier ruta inexistente o no estática vuelva a index.php
# (útil en InfinityFree cuando no se recibe el rewrite de forma puntual)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Fallback general para hosts que no ejecutan bien RewriteRule en rutas virtuales
FallbackResource /index.php
